# Required: Better Auth secret (>= 32 chars, high entropy)
NUXT_BETTER_AUTH_SECRET=

# Required for Cloudflare Workers / custom domains:
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional OAuth providers (leave blank to run read-only):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Playground admin demo (user deletion) — any non-empty string.
PLAYGROUND_ADMIN_TOKEN=change-me
