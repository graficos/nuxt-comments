{
  "name": "@graficos/nuxt-comments",
  "version": "0.5.1",
  "description": "Embeddable, unstyled comments system for Nuxt 4, backed by Cloudflare D1 and authenticated via @nuxtjs/better-auth.",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graficos/nuxt-comments.git"
  },
  "homepage": "https://github.com/graficos/nuxt-comments#readme",
  "bugs": {
    "url": "https://github.com/graficos/nuxt-comments/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "comments",
    "cloudflare",
    "d1",
    "better-auth"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./server": {
      "types": "./dist/runtime/server/index.d.ts",
      "import": "./dist/runtime/server/index.js"
    },
    "./types": {
      "types": "./dist/runtime/shared/types.d.ts"
    }
  },
  "main": "./dist/module.mjs",
  "module": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "./server": [
        "./dist/runtime/server/index.d.ts"
      ],
      "./types": [
        "./dist/runtime/shared/types.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "migrations",
    "docs",
    "playground/README.md"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "prepublishOnly": "pnpm run lint && pnpm run test",
    "dev": "pnpm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "playground:migrate": "wrangler d1 migrations apply playground-comments --local --config playground/wrangler.jsonc",
    "playground:migrate:auth": "wrangler d1 migrations apply playground-comments --local --config playground/wrangler.auth.jsonc",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.config.node.ts",
    "test:workers": "vitest run --config vitest.config.ts",
    "test:node": "vitest run --config vitest.config.node.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:types": "vue-tsc --noEmit",
    "test:types:cf": "wrangler types test/worker-configuration.d.ts --config test/wrangler.test.jsonc"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "defu": "^6.1.4",
    "ofetch": "^1.5.1",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260815.1",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.2.0",
    "@nuxtjs/better-auth": ">=0.3.0 <1.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.0",
    "better-auth": ">=1.7.1 <2",
    "eslint": "^10.9.1",
    "h3": "^1.15.11",
    "happy-dom": "^20.0.11",
    "nuxt": "^4.5.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.129.0"
  },
  "peerDependencies": {
    "@nuxtjs/better-auth": ">=0.3.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxtjs/better-auth": {
      "optional": false
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "volta": {
    "node": "22.23.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd",
      "unrs-resolver"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
